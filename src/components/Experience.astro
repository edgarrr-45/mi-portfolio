---
interface ExperienceItem {
  title: string;
  company: string;
  date: string;
  featured: boolean;
  summary: string;
  highlights: string[];
  tags: string[];
}

const experience: ExperienceItem[] = [
  {
    title: "Auxiliar Contable y de Sistemas",
    company: "Grupo empresarial (Kiwi de México, LOGOTEX)",
    date: "Dic 2023 – Actualidad",
    featured: true,
    summary:
      "Gestión de información contable multi-empresa y análisis de reportes mensuales orientados al control financiero y cumplimiento fiscal.",
    highlights: [
      "Contabilidad multi-empresa (Kiwi de México y LOGOTEX) en colaboración directa con despacho contable.",
      "Elaboración de informes contables mensuales y declaraciones informativas (DIOT) cumpliendo plazos fiscales.",
      "Diseño de tablas dinámicas en Excel para analizar informes mensuales y reducir el tiempo de procesamiento manual.",
      "Apoyo en operaciones de exportación de bienes y servicios coordinando documentación entre áreas.",
    ],
    tags: ["Excel Avanzado", "Tablas Dinámicas", "DIOT", "Reporteo Mensual", "Multi-empresa"],
  },
  {
    title: "Técnico de Sistemas",
    company: "Soluciones LAM",
    date: "2024 – 2025",
    featured: false,
    summary:
      "Soporte técnico presencial y remoto en entornos administrativos y contables para múltiples cuentas de clientes.",
    highlights: [
      "Instalación, configuración y asesoría en uso de sistemas Aspel (SAE, COI, NOI).",
      "Diagnóstico y resolución de incidencias de software y hardware adaptadas a cada empresa.",
    ],
    tags: ["Aspel SAE / COI / NOI", "Sistemas ERP", "Soporte Técnico"],
  },
  {
    title: "Asistente de Logística y Reparto",
    company: "Transportes Quinar",
    date: "Jul 2022 – May 2023",
    featured: false,
    summary:
      "Coordinación operativa en campo enfocada en eficiencia y cumplimiento de entregas.",
    highlights: [
      "Planificación y ejecución de rutas de entrega optimizando tiempos de reparto.",
    ],
    tags: ["Logística", "Planificación de Rutas", "Operaciones"],
  },
];
---

<section id="experiencia" class="max-w-4xl mx-auto px-6 py-24 border-t border-ink/10">
  <!-- Encabezado de la Sección -->
  <div class="mb-10">
    <span class="text-burnt text-xs font-semibold uppercase tracking-wider block mb-2">
      Trayectoria & Negocio Real
    </span>
    <h2 class="text-3xl md:text-4xl font-bold text-ink leading-tight">
      Experiencia Profesional
    </h2>
    <p class="mt-3 text-lg text-ink/70 leading-relaxed max-w-3xl">
      Experiencia operativa manejando información contable multi-empresa, automatizando análisis en Excel y dando soporte a sistemas ERP administrativos.
    </p>
  </div>

  <!-- Cuadrícula Editorial: Protagonista arriba (2 cols) + Secundarias debajo (1 col c/u) -->
  <div class="grid md:grid-cols-2 gap-5">
    {experience.map((item) => (
      <article
        class={`rounded-2xl flex flex-col justify-between border transition ${
          item.featured
            ? "md:col-span-2 bg-ink text-cream border-ink p-7 md:p-8 shadow-md"
            : "bg-white text-ink border-ink/10 p-6 shadow-sm"
        }`}
      >
        <div>
          <!-- Periodo + Indicador -->
          <div class="flex flex-wrap items-center justify-between gap-2 mb-4">
            <span
              class={`inline-block text-[11px] font-mono px-2.5 py-1 rounded-md ${
                item.featured
                  ? "bg-cream/10 text-cream/90 border border-cream/10"
                  : "bg-ink/5 text-ink/70"
              }`}
            >
              {item.date}
            </span>

            {item.featured && (
              <span class="inline-flex items-center gap-1.5 text-[11px] font-mono font-semibold text-burnt">
                <span class="w-1.5 h-1.5 rounded-full bg-burnt"></span>
                Rol Actual
              </span>
            )}
          </div>

          <!-- Puesto y Empresa -->
          <h3
            class={`font-bold leading-snug ${
              item.featured ? "text-xl md:text-2xl text-cream" : "text-base text-ink"
            }`}
          >
            {item.title}
          </h3>
          <p
            class={`text-xs font-medium mt-1 mb-3 ${
              item.featured ? "text-burnt" : "text-ink/60"
            }`}
          >
            {item.company}
          </p>

          <!-- Resumen -->
          <p
            class={`text-xs md:text-sm leading-relaxed mb-4 ${
              item.featured ? "text-cream/80 max-w-3xl" : "text-ink/70"
            }`}
          >
            {item.summary}
          </p>

          <!-- Logros y Responsabilidades -->
          <ul
            class={`space-y-2 text-xs leading-relaxed ${
              item.featured ? "text-cream/85 grid md:grid-cols-2 md:gap-x-6 md:space-y-0 md:gap-y-2.5" : "text-ink/75"
            }`}
          >
            {item.highlights.map((point) => (
              <li class="flex items-start gap-2">
                <span class="text-burnt font-bold mt-0.5">&rsaquo;</span>
                <span>{point}</span>
              </li>
            ))}
          </ul>
        </div>

        <!-- Etiquetas Técnicas -->
        <div
          class={`flex flex-wrap gap-1.5 mt-6 pt-4 border-t ${
            item.featured ? "border-cream/10" : "border-ink/10"
          }`}
        >
          {item.tags.map((tag) => (
            <span
              class={`text-[10px] font-mono px-2 py-0.5 rounded ${
                item.featured
                  ? "bg-cream/10 text-cream/85"
                  : "bg-ink/5 text-ink/70"
              }`}
            >
              {tag}
            </span>
          ))}
        </div>
      </article>
    ))}
  </div>
</section>
