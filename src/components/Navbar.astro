---
const cvUrl = `${import.meta.env.BASE_URL}/CV_Edgar_Gaytan.pdf`;

const navLinks = [
  { href: "#ajedrez", label: "Caso de Estudio" },
  { href: "#experiencia", label: "Experiencia" },
  { href: "#certificaciones", label: "Certificaciones" },
];
---

<nav class="sticky top-0 z-50 bg-cream/90 backdrop-blur-md border-b border-ink/10">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between gap-3">
    <a href="#hero" class="font-bold text-ink whitespace-nowrap shrink-0">
      Edgar Gaytán
    </a>

    <div class="flex items-center gap-2.5 sm:gap-5">
      <!-- Enlaces en escritorio -->
      <div class="hidden md:flex items-center gap-5">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class="text-xs font-medium text-ink/70 hover:text-ink transition whitespace-nowrap"
          >
            {link.label}
          </a>
        ))}
      </div>

      <!-- CTA siempre visible -->
      <a
        href={cvUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="bg-burnt text-cream px-3.5 py-1.5 rounded-lg text-xs font-medium whitespace-nowrap shrink-0 hover:opacity-90 transition"
      >
        Descargar CV
      </a>

      <!-- Botón de menú para móvil -->
      <button
        id="menu-toggle"
        type="button"
        class="md:hidden inline-flex items-center justify-center p-2 rounded-lg border border-ink/15 text-ink hover:bg-ink/5 transition"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Abrir menú de navegación"
      >
        <svg id="icon-open" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <line x1="4" y1="7" x2="20" y2="7" />
          <line x1="4" y1="12" x2="20" y2="12" />
          <line x1="4" y1="17" x2="20" y2="17" />
        </svg>
        <svg id="icon-close" class="w-4 h-4 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <line x1="6" y1="6" x2="18" y2="18" />
          <line x1="6" y1="18" x2="18" y2="6" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Menú desplegable en móvil -->
  <div
    id="mobile-menu"
    class="hidden md:hidden border-t border-ink/10 bg-cream/95 backdrop-blur-md"
  >
    <div class="max-w-4xl mx-auto px-4 py-3 flex flex-col gap-1">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="mobile-nav-link py-2.5 px-2 rounded-lg text-sm font-medium text-ink/80 hover:text-ink hover:bg-ink/5 transition"
        >
          {link.label}
        </a>
      ))}
    </div>
  </div>
</nav>

<script>
  const toggleBtn = document.getElementById("menu-toggle");
  const mobileMenu = document.getElementById("mobile-menu");
  const iconOpen = document.getElementById("icon-open");
  const iconClose = document.getElementById("icon-close");
  const mobileLinks = document.querySelectorAll(".mobile-nav-link");

  const setMenuOpen = (open: boolean) => {
    if (!toggleBtn || !mobileMenu || !iconOpen || !iconClose) return;
    mobileMenu.classList.toggle("hidden", !open);
    iconOpen.classList.toggle("hidden", open);
    iconClose.classList.toggle("hidden", !open);
    toggleBtn.setAttribute("aria-expanded", String(open));
  };

  toggleBtn?.addEventListener("click", () => {
    const isExpanded = toggleBtn.getAttribute("aria-expanded") === "true";
    setMenuOpen(!isExpanded);
  });

  mobileLinks.forEach((link) => {
    link.addEventListener("click", () => setMenuOpen(false));
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") setMenuOpen(false);
  });
</script>
