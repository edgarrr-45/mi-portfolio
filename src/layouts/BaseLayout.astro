---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

const { title = "Mi Portafolio | Analista de Datos" } = Astro.props;
const description = "Portafolio de Edgar Gerardo Gaytan Diaz, estudiante de Ingeniería en TIC y Analista de Datos. Proyectos de extracción vía API, pipelines limpios y visualización con Python y SQL.";

---
<!doctype html>
<html lang="es" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />

  <!-- Favicon Oficial (Caballo de Ajedrez) -->
  <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}/favicon.svg`} />

  <!-- Metadatos de Seguridad y Esquema de Color -->
  <meta name="referrer" content="strict-origin-when-cross-origin" />
  <meta http-equiv="X-Content-Type-Options" content="nosniff" />
  <meta name="color-scheme" content="light only" />
  <meta name="theme-color" content="#F3EEE3" />

  <!-- Metadatos OpenGraph para Redes Sociales -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
</head>

<body class="bg-cream text-ink">
    <Navbar />
    <main>
        <slot />
    </main>

    <Footer />
</body>

</html>